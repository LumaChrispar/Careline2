  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "start:go": "expo start --go --clear",
    "start:dev": "expo start --dev-client",
    "check:dependencies": "expo install --check",
    "doctor": "npx expo-doctor@latest",
    "export:native": "expo export --platform android --platform ios --output-dir dist-check"
  },
  "dependencies": {
