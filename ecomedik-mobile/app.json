{
  "expo": {
    "name": "Careline",
    "slug": "ecomedik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/careline-icon-v2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/careline-mark-v2.png",
        "backgroundColor": "#f6f8f5"
      },
      "package": "com.youngmangreen.ecomedik"
    },
    "web": {
      "favicon": "./assets/careline-icon-v2.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/careline-icon-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Careline to photograph laboratory documents.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "ce48b5a0-f5c3-4f8a-83c5-8280353c995c"
      },
      "owner": "lumachris1"
    },
    "scheme": "careline"
  }
}
